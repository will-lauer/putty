@REM echo off
setlocal
set MSYS_HOME=C:\msys64
set MINGW32_HOME=c:\msys64\mingw32
set MINGW64_HOME=c:\msys64\mingw64
set IMAGEMAGIC_HOME=c:\Program Files\ImageMagick-7.1.1-Q16-HDRI
set PYTHON_HOME=%LOCALAPPDATA%\Programs\Python\Python310

for /f usebackq %%a in (`c:\msys64\usr\bin\date.EXE +%%Y-%%m-%%d`) do set Ndate=%%a
for /f usebackq %%a in (`c:\msys64\usr\bin\date.EXE +%%Y%%m%%d`) do set Date=%%a
for /f %%a in (LATEST.VER) do set Lastver=%%a
set Days=0
set Puttytextver=PuTTY custom build %Date%
set Textver=Custom build %Date%
REM set Docmakever VERSION=%Puttytextver%
set Sshver=-Custom-%Date%
set Uxarcsuffix=-custom-%Date%
set Autoconfver=Custom.%Date%
set Isuffix=custom-%Date%-installer
set Ifilename32=putty-%Isuffix%
set Ifilename64=putty-64bit-%Isuffix%

set Winver=%Lastver%.%Days%.1
for /f usebackq %%a in (`echo %Winver% ^| tr . ^,`) do set Winvercommas=%%a

echo /* Generated by automated build script */ > version.h
echo #define TEXTVER "%Textver%" >> version.h
echo #define SSHVER "%Sshver%" >> version.h
echo #define BINARY_VERSION %Winvercommas% >> version.h
REM echo #define SOURCE_COMMIT "unavailable" >> version.h

set PATH=%MINGW64_HOME%\bin;%MSYS_HOME%\bin;%MSYS_HOME%\usr\bin;%IMAGEMAGIC_HOME%;%WIX%\bin;%PYTHON_HOME%;%PYTHON_HOME%\Scripts;%PATH%
mkdir docbuild
pushd docbuild
setlocal
set PATH=c:\users\WillLauer\downloads;%PATH%
cmake -G "MinGW Makefiles" ..\doc
mingw32-make
endlocal
popd
pushd doc
cp ../docbuild/*.1 .
cp ../docbuild/puttydoc.txt .
cp ../docbuild/putty.chm .
cp -r ../docbuild/html .
popd

REM cmake -G "MinGW Makefiles" . -DSTRICT=ON
REM mingw32-make VERBOSE=1

REM Windowsify LICENCE, since it's going in the Windows installer.
perl -i~ -pe "y/\015//d;s/$/\015/" LICENCE

pushd icons
mingw32-make
popd

REM from make_install_images.sh
magick -size 164x312 gradient:blue-white -distort SRT -90 -swirl 180 ( icons/putty-48.png -geometry +28+24 ) -composite ( icons/pscp-48.png -geometry +88+96 ) -composite ( icons/puttygen-48.png -geometry +28+168 ) -composite ( icons/pageant-48.png -geometry +88+240 ) -composite windows/msidialog.bmp
magick -size 493x58 canvas:white ( icons/putty-48.png -geometry +440+5 ) -composite windows/msibanner.bmp

mkdir windows\build64
pushd windows\build64
cmake -G "MinGW Makefiles" ../.. -DCMAKE_BUILD_TYPE=Release -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded -DCMAKE_C_FLAGS_RELEASE="-O2" -DSTRICT=ON
mingw32-make VERBOSE=1
popd

pushd windows
sed "s!&!build64!" build64\shipped.txt > to-sign.txt
popd

pushd windows\build64
for %%h in (md5 sha1 sha256 sha512) do (
    %%hsum *.exe | sed "s!\( \+\)\*!\1%%h/!;s!$! (installer version)!" >> %%hsums.installer
)
popd

pushd windows
candle -arch x64 -dRealPlatform=x64 -dDllOk=yes -dBuilddir=build64/ "-dWinver=%Winver%" "-dPuttytextver=%Puttytextver%" "-dHelpFilePath=../docbuild/putty.chm" installer.wxs && light -ext WixUIExtension -ext WixUtilExtension -sval installer.wixobj -o installer64.msi -spdb

REM python3 ./msifixup.py installer64.msi --dialog-bmp-width=123

popd
endlocal
